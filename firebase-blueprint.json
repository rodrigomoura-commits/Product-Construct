        "learning_date": { "type": "string", "format": "date" },
        "learning_type": { "type": "string", "enum": ["Base", "Adquirida"] },
        "theme": { "type": "string" },
        "sub_theme": { "type": "string" },
        "title": { "type": "string" },
        "learning": { "type": "string" },
        "summary": { "type": "string" },
        "classification": { "type": "string", "enum": ["fato", "hipótese", "evidência", "decisão", "risco", "pendência", "preferência", "aprendizado", "instrução", "artefato", "contexto", "regra", "exemplo", "comportamento"] },
