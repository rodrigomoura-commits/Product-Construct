        "pending_answer_expected": { "type": "string" },
        "current_intent": { "type": "string" },
        "current_reasoning_thread": { "type": "string" },
        "next_best_action": { "type": "string" },
        "unresolved_gaps": { "type": "array", "items": { "type": "string" } },
        "open_hypotheses": { "type": "array", "items": { "type": "string" } },
        "last_artifact_suggestion": { "type": "string" },
        "last_maturity_snapshot": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "paused", "resolved", "archived"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "user_id", "status"]
    },
    "Agent": {
      "title": "AI Agent",
      "description": "Definition of an AI agent and its configuration.",
