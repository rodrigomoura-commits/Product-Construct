{
  "entities": {
    "Profile": {
      "title": "User Profile",
      "description": "Standard user profile information.",
      "type": "object",
      "properties": {
        "display_name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar_url": { "type": "string", "format": "uri" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["display_name", "email"]
    },
    "UserRole": {
      "title": "User Role",
      "description": "Role-based access control for users.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "editor", "viewer"] },
        "granted_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "role"]
    },
    "Product": {
      "title": "Product Workspace",
      "description": "A workspace for a specific product being constructed.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "product_type": { "type": "string" },
        "objective": { "type": "string" },
        "owner_id": { "type": "string" },
        "organization_id": { "type": "string" },
        "area": { "type": "string" },
        "team": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "archived", "completed"] },
        "current_stage": { "type": "string" },
        "progress": { "type": "number" },
        "quality_score": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "owner_id"]
    },
    "ProductStage": {
      "title": "Product Stage",
      "description": "One of the 6 stages of product construction.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_key": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "incomplete", "ready_for_review", "approved", "reopened"] },
