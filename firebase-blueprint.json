        "quality_score": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "stage_key", "status"]
    },
    "StageField": {
      "title": "Stage Field",
      "description": "A specific data point within a product stage.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_key": { "type": "string" },
        "field_key": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": "string" },
        "classification": { "type": "string", "enum": ["fact", "hypothesis", "evidence", "decision", "risk", "pending"] },
        "quality_status": { "type": "string", "enum": ["empty", "draft", "sufficient", "strong", "needs_review"] },
        "quality_reason": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "stage_key", "field_key"]
    },
    "Artifact": {
      "title": "Product Artifact",
      "description": "A versioned document generated during the product journey.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending", "approved", "rejected"] },
        "content": { "type": "string" },
        "source_data": { "type": "object" },
        "created_by": { "type": "string" },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "type", "title", "version"]
    },
    "Decision": {
      "title": "Product Decision",
      "description": "A decision made regarding the product strategy or execution.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "reason": { "type": "string" },
        "evidence": { "type": "string" },
        "impact": { "type": "string" },
        "status": { "type": "string", "enum": ["proposed", "in_discussion", "approved", "reverted", "obsolete"] },
        "author_id": { "type": "string" },
        "previous_decision_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "title", "author_id", "status"]
    },
    "Memory": {
      "title": "Generative Memory",
      "description": "Stored context and learning for the product or organization.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "type": { "type": "string", "enum": ["base", "learned", "decision", "evidence", "style", "gap", "risk", "rule", "template", "instruction"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "pending", "approved", "rejected", "archived", "obsolete", "conflict"] },
        "can_ai_use": { "type": "boolean" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "previous_version_id": { "type": "string" }
      },
      "required": ["type", "title", "content", "status"]
    },
    "Document": {
      "title": "Uploaded Document",
      "description": "Files uploaded and processed by the system.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "title": { "type": "string" },
        "file_url": { "type": "string", "format": "uri" },
        "file_type": { "type": "string" },
        "processing_status": { "type": "string", "enum": ["pending", "processing", "processed", "error"] },
        "extracted_content": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["product_id", "title", "file_url"]
    },
    "HistoryEvent": {
      "title": "History Event",
      "description": "A log entries for activity tracking.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "event_type": { "type": "string" },
        "description": { "type": "string" },
        "actor_id": { "type": "string" },
        "metadata": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["event_type", "description", "created_at"]
    },
    "ConversationMemory": {
      "title": "Conversation Memory",
      "description": "State of the AI assistant conversation.",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "user_id": { "type": "string" },
        "active_stage_key": { "type": "string" },
        "conversation_summary": { "type": "string" },
        "last_assistant_message": { "type": "string" },
        "last_user_message": { "type": "string" },
        "last_question_asked": { "type": "string" },
        "last_question_type": { "type": "string" },
        "last_options_presented": { "type": "array" },
        "selected_options": { "type": "array", "items": { "type": "string" } },
