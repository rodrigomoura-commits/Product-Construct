rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isSignedIn()
        && (
          userDoc().data.system_role == "owner"
          || userDoc().data.role == "owner"
          || userDoc().data.email == "rodrigo.moura@hotmart.com"
          || request.auth.token.email == "rodrigo.moura@hotmart.com"
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isOwner()
          || userDoc().data.system_role == "admin"
          || userDoc().data.role == "admin"
        );
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    function hasUserProductAccess(productId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/user_product_access/$(request.auth.uid)/products/$(productId))
        && get(/databases/$(database)/documents/user_product_access/$(request.auth.uid)/products/$(productId)).data.status == "active";
    }

    function getUserProductRole(productId) {
      return get(/databases/$(database)/documents/user_product_access/$(request.auth.uid)/products/$(productId)).data.role;
    }

    function isProductParticipant(productId) {
      return isSignedIn() && (
        isOwnerOrAdmin() ||
        hasUserProductAccess(productId) ||
        get(/databases/$(database)/documents/products/$(productId)).data.owner_id == request.auth.uid
      );
    }

    function canViewProduct(productId) {
      return isProductParticipant(productId);
    }

    function canUseTona(productId) {
      return isOwnerOrAdmin()
        || (
          hasUserProductAccess(productId)
          && getUserProductRole(productId) in ["owner", "editor", "commenter"]
        );
    }

    function canCommentProduct(productId) {
      return isOwnerOrAdmin() || (
        hasUserProductAccess(productId) && 
        getUserProductRole(productId) in ["owner", "editor", "commenter"]
      );
    }

    function canEditProduct(productId) {
      return isOwnerOrAdmin() || (
        hasUserProductAccess(productId) && 
        getUserProductRole(productId) in ["owner", "editor"]
      );
    }

    function canManageProductAccess(productId) {
      return isOwnerOrAdmin() || (
        hasUserProductAccess(productId) && 
        getUserProductRole(productId) == "owner"
      );
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isOwnerOrAdmin();

      allow create: if isSignedIn() && isSelf(userId);

      allow update: if
        isSelf(userId)
        && !("system_role" in request.resource.data.diff(resource.data).changedKeys())
        && !("status" in request.resource.data.diff(resource.data).changedKeys());

      allow update: if isOwner();

      allow update: if
        isOwnerOrAdmin()
        && resource.data.system_role == "user"
        && request.resource.data.system_role == resource.data.system_role;

      allow delete: if isOwnerOrAdmin();
    }

    match /user_invites/{inviteId} {
      allow read: if isOwnerOrAdmin();

      allow create: if isOwnerOrAdmin();

      allow update: if isOwnerOrAdmin();

      allow delete: if isOwner();
    }

    match /audit_logs/{logId} {
      allow read: if isOwnerOrAdmin();

      allow create: if isOwnerOrAdmin();

      allow update, delete: if false;
    }

    match /user_product_access/{userId}/products/{productId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwnerOrAdmin());
      allow create, update, delete: if isOwnerOrAdmin() || isSelf(userId);
    }

    match /user_product_access/{userId} {
      allow read, delete: if isOwnerOrAdmin() || isSelf(userId);
      allow create, update: if isOwnerOrAdmin();
    }

    match /products/{productId} {
      allow read: if canViewProduct(productId);
      allow create: if isSignedIn();
      allow update: if canEditProduct(productId);
      allow delete: if canManageProductAccess(productId);

      match /stages/{stageId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /fields/{fieldId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /artifacts/{artifactId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /decisions/{decisionId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /memories/{memoryId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /documents/{documentId} {
        allow read: if canViewProduct(productId);
        allow create, update: if canEditProduct(productId);
        allow delete: if canManageProductAccess(productId);
      }

      match /history/{eventId} {
        allow read: if canViewProduct(productId);
        allow create: if canCommentProduct(productId);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if canViewProduct(productId);
        allow create: if canUseTona(productId);
        allow update, delete: if canEditProduct(productId);
      }

      match /conversation_memory/{userId} {
        allow read: if canViewProduct(productId) && (request.auth.uid == userId || isOwnerOrAdmin());
        allow write: if canCommentProduct(productId) && request.auth.uid == userId;
      }

      match /collaborators/{collaboratorId} {
        allow read: if canViewProduct(productId);
        allow create, update, delete: if canManageProductAccess(productId);
      }

      match /invites/{inviteId} {
        allow read, create, update, delete: if canManageProductAccess(productId);
      }
      
      // Fallback for any other sub-collection
      match /{subCollection=**}/{docId} {
        allow read: if canViewProduct(productId);
        allow write: if canEditProduct(productId);
      }
    }

    // MINDFLOW ADMINISTRATIVE COLLECTIONS
    match /mindflow_conflict_groups/{docId} {
      allow read, write: if isOwnerOrAdmin();
      match /{subPath=**} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /mindflow_learnings/{learningId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwnerOrAdmin();
      match /{subPath=**} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    match /mindflow_learning_candidates/{docId} {
      allow read, write: if isOwnerOrAdmin();
      match /{subPath=**} {
        allow read, write: if isOwnerOrAdmin();
      }
    }

    match /mindflow_import_history/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_behavioral_profiles/{userId} {
      allow read, write: if isOwnerOrAdmin() || isSelf(userId);
    }

    match /mindflow_behavioral_signals/{signalId} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isOwnerOrAdmin() || (isSignedIn() && request.resource.data.user_id == request.auth.uid);
      allow update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_behavioral_biometrics/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_cognitive_traces/{traceId} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isOwnerOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if isOwnerOrAdmin();
    }

    match /mindflow_cognitive_trace_events/{eventId} {
      allow read: if isOwnerOrAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    match /mindflow_runtime_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_sensory_trails/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_deep_reasonings/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_reasonings/{reasoningId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_reasoning_runs/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_conflicts/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwnerOrAdmin();
    }

    match /mindflow_retrieval_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_import_jobs/{docId} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /mindflow_context_maps/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwnerOrAdmin();
    }

    match /mindflow_learning_relationships/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwnerOrAdmin();
    }

    // MULTI-USER MINDFLOW COLLECTIONS
    match /mindflow_user_memories/{userId}/memories/{memoryId} {
      allow read, create, update: if isOwnerOrAdmin() || isSelf(userId);
      allow delete: if isOwnerOrAdmin();
    }

    match /mindflow_product_memories/{productId}/memories/{memoryId} {
      allow read: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow create: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_product_synthesis/{productId}/items/{itemId} {
      allow read: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow create, update: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow delete: if isOwnerOrAdmin();
    }

    match /mindflow_interactions/{productId}/events/{eventId} {
      allow read: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow create: if isOwnerOrAdmin() || isProductParticipant(productId);
      allow update, delete: if false;
    }

    match /mindflow_logs/{logId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isOwnerOrAdmin();
    }

    match /mindflow_guardrails/{guardrailId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /deleted_users/{email} {
      allow read, write: if isOwnerOrAdmin();
    }

    match /stage_agent_configs/{configId} {
      allow read: if isSignedIn();
      allow write: if isOwnerOrAdmin();
    }
    match /scheduler_jobs/{jobId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /scheduler_runs/{runId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin();
      allow update: if isOwnerOrAdmin();
      allow delete: if isOwner();
    }

    match /scheduler_audit_logs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin();
      allow update, delete: if false;
    }

    match /scheduled_actions/{actionId} {
      allow read: if isOwnerOrAdmin();
      allow create: if isOwnerOrAdmin();
      allow update: if isOwnerOrAdmin();
      allow delete: if isOwner();
    }
  }
}
